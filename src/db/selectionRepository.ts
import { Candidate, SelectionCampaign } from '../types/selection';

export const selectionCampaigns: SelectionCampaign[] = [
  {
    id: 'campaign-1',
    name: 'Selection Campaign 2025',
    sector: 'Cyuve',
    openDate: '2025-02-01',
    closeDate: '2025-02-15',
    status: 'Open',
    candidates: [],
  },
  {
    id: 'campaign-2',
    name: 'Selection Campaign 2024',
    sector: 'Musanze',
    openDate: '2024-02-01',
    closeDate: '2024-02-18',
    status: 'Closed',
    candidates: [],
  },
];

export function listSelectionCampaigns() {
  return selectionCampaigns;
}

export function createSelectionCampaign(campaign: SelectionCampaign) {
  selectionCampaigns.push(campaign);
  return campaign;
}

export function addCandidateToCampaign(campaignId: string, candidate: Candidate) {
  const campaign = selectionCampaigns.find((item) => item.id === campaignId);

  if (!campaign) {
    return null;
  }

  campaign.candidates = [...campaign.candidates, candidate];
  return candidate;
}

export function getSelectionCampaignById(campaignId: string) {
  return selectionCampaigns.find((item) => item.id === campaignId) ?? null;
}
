import * as React from 'react';
import { View, Text, StyleSheet, ScrollView, Pressable } from 'react-native';
import type { NativeStackScreenProps } from '@react-navigation/native-stack';
import type { RootStackParamList } from '../navigation/RootNavigator';
import type { Role } from '../types/core';

type Props = NativeStackScreenProps<RootStackParamList, 'Home'>;

const quickActions = [
  { title: 'Selection campaigns', route: 'SelectionCampaignList' as const, description: 'Create and review candidate campaigns' },
  { title: 'New candidate', route: 'CandidateForm' as const, description: 'Add a new eligible candidate to a campaign' },
  { title: 'Beneficiary registry', route: 'BeneficiaryList' as const, description: 'Search and view beneficiary profiles' },
  { title: 'New beneficiary', route: 'BeneficiaryForm' as const, description: 'Create a new beneficiary record' },
];

const roleColors: Record<Role, string> = {
  DISTRICT_ADMIN: '#1d4ed8',
  SECTOR: '#0f766e',
  CELL: '#9333ea',
  VILLAGE: '#d97706',
  FIELD_OFFICER: '#dc2626',
  VIEWER: '#6b7280',
};

export default function HomeScreen({ navigation, route }: Props) {
  const userName = route.params?.userName ?? 'Admin';
  const role = route.params?.role ?? 'DISTRICT_ADMIN';

  return (
    <ScrollView contentContainerStyle={styles.container}>
      <View style={styles.headerCard}>
        <Text style={styles.greeting}>Welcome back</Text>
        <Text style={styles.userName}>{userName}</Text>
        <View style={[styles.roleBadge, { backgroundColor: roleColors[role] }]}>
          <Text style={styles.roleText}>{role.replace('_', ' ')}</Text>
        </View>
      </View>

      <Text style={styles.sectionTitle}>Quick actions</Text>
      {quickActions.map((action) => (
        <Pressable
          key={action.title}
          onPress={() => navigation.navigate(action.route)}
          style={({ pressed }) => [styles.card, pressed && styles.cardPressed]}
        >
          <Text style={styles.cardTitle}>{action.title}</Text>
          <Text style={styles.cardText}>{action.description}</Text>
        </Pressable>
      ))}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
